generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auditflow"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model anomalie {
  id                                            String                @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  mission_id                                    String                @db.Uuid
  mission_cycle_id                              String?               @db.Uuid
  test_execution_id                             String?               @db.Uuid
  statut_id                                     Int
  reference                                     String                @db.VarChar(50)
  titre                                         String                @db.VarChar(255)
  description                                   String
  assertion_concernee                           String?               @db.VarChar(50)
  montant_impact                                Decimal?              @db.Decimal(15, 2)
  pourcentage_impact                            Decimal?              @db.Decimal(5, 2)
  impact_significatif                           Boolean?              @default(false)
  ajustement_propose                            String?
  ajustement_montant                            Decimal?              @db.Decimal(15, 2)
  ajustement_accepte                            Boolean?
  ouverte_par                                   String                @db.Uuid
  date_ouverture                                DateTime?             @default(now()) @db.Timestamptz(6)
  assignee_a                                    String?               @db.Uuid
  date_cloture                                  DateTime?             @db.Timestamptz(6)
  close_par                                     String?               @db.Uuid
  conclusion                                    String?
  documents_lies                                Json?                 @default("[]")
  created_at                                    DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime?             @default(now()) @db.Timestamptz(6)
  utilisateur_anomalie_assignee_aToutilisateur  utilisateur?          @relation("anomalie_assignee_aToutilisateur", fields: [assignee_a], references: [id], onDelete: NoAction, onUpdate: NoAction)
  utilisateur_anomalie_close_parToutilisateur   utilisateur?          @relation("anomalie_close_parToutilisateur", fields: [close_par], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mission_cycle                                 mission_cycle?        @relation(fields: [mission_cycle_id], references: [id], onUpdate: NoAction)
  mission                                       mission               @relation(fields: [mission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  utilisateur_anomalie_ouverte_parToutilisateur utilisateur           @relation("anomalie_ouverte_parToutilisateur", fields: [ouverte_par], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ref_statut_anomalie                           ref_statut_anomalie   @relation(fields: [statut_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  test_execution                                test_execution?       @relation(fields: [test_execution_id], references: [id], onUpdate: NoAction)
  anomalie_historique                           anomalie_historique[]
  notification                                  notification[]

  @@index([mission_cycle_id], map: "idx_anomalie_cycle")
  @@index([mission_id], map: "idx_anomalie_mission")
  @@index([ouverte_par], map: "idx_anomalie_ouverte_par")
  @@index([reference], map: "idx_anomalie_reference")
  @@index([statut_id], map: "idx_anomalie_statut")
  @@schema("auditflow")
}

model anomalie_historique {
  id                                                                            String               @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  anomalie_id                                                                   String               @db.Uuid
  statut_precedent                                                              Int?
  statut_nouveau                                                                Int
  commentaire                                                                   String?
  modifie_par                                                                   String               @db.Uuid
  date_modification                                                             DateTime?            @default(now()) @db.Timestamptz(6)
  anomalie                                                                      anomalie             @relation(fields: [anomalie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  utilisateur                                                                   utilisateur          @relation(fields: [modifie_par], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ref_statut_anomalie_anomalie_historique_statut_nouveauToref_statut_anomalie   ref_statut_anomalie  @relation("anomalie_historique_statut_nouveauToref_statut_anomalie", fields: [statut_nouveau], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ref_statut_anomalie_anomalie_historique_statut_precedentToref_statut_anomalie ref_statut_anomalie? @relation("anomalie_historique_statut_precedentToref_statut_anomalie", fields: [statut_precedent], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([anomalie_id], map: "idx_anomalie_hist_anomalie")
  @@schema("auditflow")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
