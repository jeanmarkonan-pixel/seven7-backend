# Copier en .env — ne jamais commiter le .env réel
DATABASE_URL="postgresql://auditflow:auditflow_dev@localhost:5432/auditflow?schema=auditflow"
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
JWT_SECRET="change-moi-en-un-secret-long-et-aleatoire-en-production"
# Origine autorisée pour le CORS (le front Next.js en dev)
WEB_ORIGIN="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
