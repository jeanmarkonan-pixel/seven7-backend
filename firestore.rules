// Règles déployées sur le projet seven7-audit, relevées dans la console
// Firebase le 03/08/2026. C'est désormais la référence : toute évolution
// se fait ici, puis `firebase deploy --only firestore:rules`.
//
// Couverture : tests/rules.test.js (émulateur Firestore, JDK requis).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /seven7_dossiers_public/{dossier} {
      allow get: if true;
      // Nouveau : lister TOUS les dossiers d'un cabinet (tableau de bord cabinet) n'est
      // autorisé qu'au compte Auth de CE cabinet précis (email fictif cabinet-{code}@...,
      // même mécanisme que les comptes Auth par dossier). La lecture d'un dossier UN PAR UN
      // (allow get, ci-dessus) reste publique et inchangée, pour ne rien casser côté écran
      // de connexion (affichage du nom de cabinet avant authentification).
      allow list: if request.auth != null
        && resource.data.cabinetId is string
        && request.auth.token.email == 'cabinet-' + resource.data.cabinetId.lower() + '@seven7-audit.local';
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
    }
    // E5 : les paliers d'abonnement (STARTER/PRO/CABINET) et leurs plafonds/
    // fonctionnalités ne sont JAMAIS codés en dur (§3, §11) — cette donnée vit
    // ici, dans /plans/{planId} (voir migration/plans.mjs, qui l'écrit) et
    // gouverne à la fois l'écran de comparaison (lecture publique, y compris
    // avant connexion) et ongletReserveParPalier ci-dessous (lecture via
    // donneesCabinet(code).plan, pas via cette collection directement).
    // Écriture réservée à SEVEN7 : jamais depuis un client, même admin de
    // cabinet — même principe que seven7_cabinets/cabinets ci-dessus (le
    // palier souscrit ne se change pas soi-même).
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }
    match /seven7_usage_stats/{jour} {
      allow read, write: if request.auth != null;
      match /cabinets/{cabinetId} {
        allow read, write: if request.auth != null;
      }
    }
    match /seven7_dossiers/{dossier} {
      // Phase 5 : un dossier lié à un cabinet (voir les fonctions PONT
      // plus bas, hissées par Firestore quel que soit leur ordre textuel)
      // devient lisible par ses membres, EN PLUS de l'accès historique par
      // authUid — jamais à sa place. delete reste strictement réservé à
      // authUid ; update aussi, SAUF l'exception ci-dessous (lier un
      // dossier à un cabinet), qui donne accès à son contenu, jamais le
      // droit de le renommer ou de le supprimer par ce biais.
      allow read: if request.auth != null
        && (resource.data.authUid == request.auth.uid || accesPontLecture(resource.data));
      allow update, delete: if request.auth != null
        && resource.data.authUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.authUid == request.auth.uid;
      allow update: if request.auth != null
        && !('authUid' in resource.data)
        && resource.data.password is string
        && request.resource.data.password == resource.data.password
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']);

      // Phase 5 : lier un dossier ANCIEN existant à un cabinet, exécuté
      // par l'ADMIN du cabinet — PAS par le propriétaire historique du
      // dossier (une session Auth n'est connectée qu'à un seul compte à
      // la fois). Choix explicite de l'utilisateur (10/08/2026) : plutôt
      // qu'une double connexion successive, l'admin prouve sa
      // connaissance du mot de passe du dossier en le resoumettant
      // INCHANGÉ dans la même écriture — exactement le même principe que
      // le pont de migration authUid ci-dessus (ligne 45), qui prouve
      // déjà la connaissance d'un secret de la même façon sans jamais
      // l'exposer autrement que ce qu'il est déjà (lisible par le seul
      // propriétaire authUid, comme avant cette phase).
      //
      // Trois garde-fous, chacun testé :
      //  1. !('cabinetCode' in resource.data) — un dossier déjà lié ne
      //     peut plus être relié ailleurs par ce chemin. Sans lui, un
      //     admin qui obtiendrait le mot de passe d'un dossier déjà
      //     affecté à un AUTRE cabinet pourrait le « voler ».
      //  2. affectedKeys().hasOnly(['cabinetCode','dossierNouveauId']) —
      //     cette écriture ne peut RIEN modifier d'autre sur le dossier,
      //     en particulier pas son contenu ni son authUid.
      //  3. le get() ci-dessous vérifie que cabinets/{code}/dossiers/
      //     {dossierNouveauId} existe déjà ET pointe bien vers CE
      //     dossier (dossierAncienId == dossier). Cette entrée ne peut
      //     avoir été créée que via la règle E2 plus bas (estAdmin +
      //     quotaDisponible), donc impossible de lier un dossier sans
      //     être passé par le contrôle de quota — sinon un admin outillé
      //     pourrait lier des dossiers ancien-modèle indéfiniment sans
      //     jamais consommer de quota, contournant E4.
      allow update: if request.auth != null
        && !('cabinetCode' in resource.data)
        && resource.data.password is string
        && request.resource.data.password == resource.data.password
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cabinetCode', 'dossierNouveauId'])
        && request.resource.data.cabinetCode is string
        && request.resource.data.dossierNouveauId is string
        && estAdmin(request.resource.data.cabinetCode)
        && cabinetActif(request.resource.data.cabinetCode)
        && get(/databases/$(database)/documents/cabinets/$(request.resource.data.cabinetCode)/dossiers/$(request.resource.data.dossierNouveauId)).data.dossierAncienId == dossier;
      match /tabs/{tabId} {
        // E3 (rôle) : lecture ouverte à tout membre affecté ; écriture
        // réservée à l'ADMIN sur les onglets de la liasse
        // (ongletLiasseVerrouille), ouverte à tous les autres onglets
        // (cycle d'audit, QCI, revue analytique — la matrice des droits,
        // §5, les laisse au collaborateur).
        //
        // Palier (10/08/2026) : EN PLUS d'E3, certains onglets sont
        // réservés au palier du cabinet lui-même (ongletReserveParPalier),
        // et cette restriction-là s'applique À TOUS les membres, admin
        // compris — c'est pourquoi elle est vérifiée en lecture aussi
        // (accesPontLectureOnglet), pas seulement en écriture.
        allow read: if request.auth != null && (
          donneesDossierAncien(dossier).authUid == request.auth.uid
          || accesPontLectureOnglet(donneesDossierAncien(dossier), tabId)
        );
        allow write: if request.auth != null && (
          donneesDossierAncien(dossier).authUid == request.auth.uid
          || accesPontEcriture(donneesDossierAncien(dossier), tabId)
        );
      }
      match /historique/{entryId} {
        allow read: if request.auth != null && (
          donneesDossierAncien(dossier).authUid == request.auth.uid
          || accesPontLecture(donneesDossierAncien(dossier))
        );
        allow write: if request.auth != null
          && donneesDossierAncien(dossier).authUid == request.auth.uid;
      }
      match /presence/{sessionId} {
        allow read, write: if request.auth != null && (
          donneesDossierAncien(dossier).authUid == request.auth.uid
          || accesPontLecture(donneesDossierAncien(dossier))
        );
      }
      match /archives/{archiveId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
        match /tabs/{tabId} {
          allow read, write: if request.auth != null
            && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
        }
      }
      match /conversations/{convId} {
        allow read, write: if request.auth != null && (
          donneesDossierAncien(dossier).authUid == request.auth.uid
          || accesPontLecture(donneesDossierAncien(dossier))
        );
        match /messages/{msgId} {
          allow read, write: if request.auth != null && (
            donneesDossierAncien(dossier).authUid == request.auth.uid
            || accesPontLecture(donneesDossierAncien(dossier))
          );
        }
      }
    }
    match /seven7_cabinets/{cabinetId} {
      allow read: if true;
      // Seul le compteur "dossiersCreesAnnee" est modifiable depuis le client, par pas de
      // +1 exactement, et JAMAIS au-delà du plafond du cabinet. Le palier et le plafond
      // eux-mêmes ne se changent que depuis la console : aucune règle ne les autorise ici.
      //
      // La troisième condition avait disparu d'une version déployée. Son rétablissement
      // le 03/08/2026 est un CHOIX COMMERCIAL ASSUMÉ : le plafond bloque, un client qui
      // l'atteint doit changer de palier. La grille tarifaire annonçait jusqu'ici un
      // dépassement « facturé à l'unité » — cette possibilité n'existe plus côté serveur,
      // et la grille doit être mise à jour en conséquence.
      // Couverte par le test « CABINETS — le plafond d'abonnement est opposable ».
      //
      // DEUX CONDITIONS SUR LA DONNÉE, sous peine de bloquer des clients légitimes :
      //   · tout cabinet doit porter "plafondDossiers" — un document qui en est dépourvu
      //     fait échouer l'évaluation, donc refuse la création de dossier ;
      //   · le palier « Cabinet Plus » est illimité au tarif, mais pas dans le code : il
      //     se représente par un plafond très grand. Voir SEUIL_ILLIMITE = 9999 dans
      //     src/js/10-config-collaboration.js, au-delà duquel l'interface affiche
      //     « illimité » au lieu d'un chiffre.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dossiersCreesAnnee'])
        && request.resource.data.dossiersCreesAnnee == resource.data.dossiersCreesAnnee + 1
        && request.resource.data.dossiersCreesAnnee <= resource.data.plafondDossiers;
    }

    // ================================================================
    // NOUVEAU MODÈLE — phase 2 (schéma cabinets/rôles/paliers)
    //
    // Coexiste avec seven7_cabinets/seven7_dossiers ci-dessus, qu'il ne
    // modifie ni ne remplace : la période de transition (phase 3) exige
    // que l'ancien mécanisme de connexion reste fonctionnel. Un cabinet
    // migré porte migreDepuisAncienSchema: true (voir migration/) mais
    // son ancien document seven7_cabinets/{code} n'est jamais touché.
    //
    // Pas de Cloud Functions (plan Spark) : tout est porté par get() et
    // par la forme des écritures autorisées. Les limites précises de ce
    // choix sont documentées à l'endroit où elles s'appliquent, jamais
    // passées sous silence.
    // ================================================================

    function estMembre(code) {
      return request.auth != null
        && exists(/databases/$(database)/documents/cabinets/$(code)/membres/$(request.auth.uid));
    }
    function donneesMembre(code) {
      return get(/databases/$(database)/documents/cabinets/$(code)/membres/$(request.auth.uid)).data;
    }
    function estAdmin(code) {
      return estMembre(code) && donneesMembre(code).role == 'ADMIN' && donneesMembre(code).actif == true;
    }
    function donneesCabinet(code) {
      return get(/databases/$(database)/documents/cabinets/$(code)).data;
    }

    // ----------------------------------------------------------------
    // PONT vers l'ancien modèle (phase 5) — un seven7_dossiers/{dossier}
    // qu'un admin a lié à son cabinet porte deux champs supplémentaires,
    // posés au moment du lien, jamais avant : cabinetCode (le cabinet) et
    // dossierNouveauId (l'id du document cabinets/{code}/dossiers/{id}
    // correspondant — nécessaire pour lire dossiersAffectes, qui référence
    // CET id-là, pas celui de seven7_dossiers). Un dossier non lié n'a ni
    // l'un ni l'autre : pontValide() renvoie false, et tout le reste de ce
    // bloc se comporte comme si le pont n'existait pas — l'accès historique
    // par authUid, seul, continue de gouverner ces dossiers-là.
    //
    // get() sur un même chemin est mis en cache par Firestore pour la
    // durée d'une évaluation : appeler donneesDossierAncien(dossier)
    // plusieurs fois dans les fonctions ci-dessous ne coûte qu'UNE lecture
    // réelle, pas une par appel — vérifié empiriquement (voir la suite de
    // tests), pas seulement supposé du fonctionnement documenté.
    function donneesDossierAncien(dossier) {
      return get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data;
    }
    function pontValide(donneesDossier) {
      return donneesDossier.cabinetCode is string && donneesDossier.dossierNouveauId is string;
    }
    // Lecture par le pont : membre actif du cabinet, ET (admin, qui voit
    // tout, OU dossier explicitement affecté — jamais déduit autrement).
    //
    // « actif == true » explicite ici, pas seulement estMembre() : comme
    // pour /cabinets/{code}/dossiers ci-dessous, estMembre() ne vérifie que
    // l'EXISTENCE du document membre, donc à elle seule elle laisserait un
    // collaborateur désactivé continuer de lire les dossiers déjà
    // affectés via le pont. estAdmin() inclut déjà ce contrôle, donc seule
    // la branche collaborateur a besoin de la vérification explicite.
    function accesPontLecture(donneesDossier) {
      return pontValide(donneesDossier)
        && estMembre(donneesDossier.cabinetCode)
        && (estAdmin(donneesDossier.cabinetCode)
            || (donneesMembre(donneesDossier.cabinetCode).actif == true
                && donneesDossier.dossierNouveauId in donneesMembre(donneesDossier.cabinetCode).dossiersAffectes));
    }
    // E3 : la liasse (bilan, passif, résultat, TFT, notes, fiches R, états
    // DGI/INS) est verrouillée à l'écriture pour un collaborateur — SAUF
    // liasse-parametres, qui n'est pas un état financier mais un réglage,
    // et reste modifiable par tous ceux qui ont accès au dossier.
    function ongletLiasseVerrouille(tabId) {
      return tabId.matches('^liasse-.*') && tabId != 'liasse-parametres';
    }

    // Restriction par PALIER d'abonnement (10/08/2026, décision utilisateur),
    // distincte d'E3 : E3 restreint selon le RÔLE dans le cabinet (admin vs
    // collaborateur) ; ceci restreint selon ce à quoi le CABINET a souscrit,
    // pour TOUS ses membres également, admin compris — un admin d'un cabinet
    // STARTER n'a pas plus accès à la liasse qu'un de ses collaborateurs.
    //
    // Ici, contrairement à ongletLiasseVerrouille, AUCUNE exception pour
    // liasse-parametres : si le palier du cabinet n'inclut pas le module
    // liasse du tout, aucun de ses 18 onglets n'est accessible, paramètres
    // compris — l'exception « paramètres toujours modifiable » ne s'applique
    // qu'AU SEIN d'un cabinet qui a déjà accès au module (voir
    // accesPontEcriture ci-dessous, qui combine les deux).
    //
    // donneesCabinet(code).plan absent d'un document (cabinet non encore
    // migré vers ce champ) fait échouer l'évaluation, donc refuse l'accès
    // par défaut — même choix, déjà établi, que plafondDossiers ci-dessus.
    function ongletReserveParPalier(code, tabId) {
      return (tabId.matches('^liasse-.*') && donneesCabinet(code).plan != 'CABINET')
        || ((tabId == 'detection' || tabId == 'revue' || tabId == 'impots' || tabId == 'calendrier')
            && !(donneesCabinet(code).plan in ['PRO', 'CABINET']));
    }
    function accesPontLectureOnglet(donneesDossier, tabId) {
      return accesPontLecture(donneesDossier)
        && !ongletReserveParPalier(donneesDossier.cabinetCode, tabId);
    }
    function accesPontEcriture(donneesDossier, tabId) {
      return accesPontLecture(donneesDossier)
        && !ongletReserveParPalier(donneesDossier.cabinetCode, tabId)
        && (estAdmin(donneesDossier.cabinetCode) || !ongletLiasseVerrouille(tabId));
    }
    function cabinetActif(code) {
      return donneesCabinet(code).statut == 'ACTIF';
    }
    function quotaDisponible(code) {
      return donneesCabinet(code).dossiersUtilises < donneesCabinet(code).quotaDossiers;
    }

    match /cabinets/{code} {
      // Un membre lit son propre cabinet (nom, palier, quota affiché à
      // l'écran) ; la création/suppression d'un cabinet n'est jamais une
      // action client — c'est SEVEN7 qui l'exécute via le script de
      // migration ou l'onboarding, avec des identifiants de service.
      allow read: if estMembre(code);
      allow create, delete: if false;

      // Seul le compteur dossiersUtilises est modifiable depuis le
      // client, par pas de +1 exactement, jamais au-delà du quota — même
      // mécanisme, déjà éprouvé, que seven7_cabinets ci-dessus. plan,
      // quotaDossiers, statut, dateFin : AUCUNE règle ne les autorise ici,
      // ils sont donc en lecture seule côté client, sans exception.
      allow update: if estAdmin(code)
        && cabinetActif(code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dossiersUtilises'])
        && request.resource.data.dossiersUtilises == resource.data.dossiersUtilises + 1
        && request.resource.data.dossiersUtilises <= resource.data.quotaDossiers;

      match /membres/{uid} {
        // Un membre voit la liste de ses collègues (nom, rôle — pas de
        // secret ici) ; seul un ADMIN peut créer ou modifier un membre,
        // et jamais désactiver ou changer le rôle de SON PROPRE compte —
        // ce qui, combiné à l'interdiction de créer un second admin par
        // un non-admin, empêche un cabinet de se retrouver sans aucun
        // administrateur actif. Affiné en phase 4 (désactivation d'un
        // collègue, affectation de dossiers).
        //
        // Chacun peut TOUJOURS lire SON PROPRE document membre, même
        // s'il n'appartient pas à ce cabinet (le document n'existe alors
        // pas, et la lecture renvoie simplement « inexistant »). Sans
        // cette clause, estMembre() interrogeait un document que la règle
        // refusait ensuite de lire : l'écran de connexion recevait
        // « permission-denied » là où il devait distinguer « vous n'êtes
        // pas membre de ce cabinet » — un message que l'utilisateur peut
        // corriger seul, en vérifiant le code saisi. Aucune information
        // n'est exposée : on ne peut lire que le document portant son
        // propre uid, jamais celui d'autrui.
        allow read: if estMembre(code) || (request.auth != null && uid == request.auth.uid);
        allow create, update: if estAdmin(code) && uid != request.auth.uid;
        allow delete: if false;
      }

      match /dossiers/{dossierId} {
        // Un ADMIN lit tout ; un COLLABORATEUR ACTIF ne lit que les
        // dossiers listés dans SON PROPRE document membre — jamais un
        // tableau fourni par le client, toujours relu en base.
        //
        // « actif == true » explicite ici, pas seulement estMembre() :
        // estMembre() ne vérifie que l'EXISTENCE du document (utile pour
        // qu'un collègue désactivé reste visible dans la liste de
        // l'équipe), donc à elle seule elle laisserait un collaborateur
        // désactivé continuer de lire les dossiers déjà affectés. Trouvé
        // en écrivant le test « COLLABORATEUR DÉSACTIVÉ » — corrigé ici,
        // pas seulement documenté.
        allow read: if estAdmin(code)
          || (estMembre(code) && donneesMembre(code).actif == true
              && dossierId in donneesMembre(code).dossiersAffectes);

        // E2 : seul l'ADMIN crée un dossier, jamais un collaborateur, ni
        // par l'interface ni par appel direct — c'est ici, pas dans
        // l'écran, que ça se joue réellement (§5 du cahier des charges).
        //
        // numeroSequence doit égaler dossiersUtilises + 1 du cabinet AU
        // MOMENT DE LA LECTURE (get(), donc l'état d'AVANT la transaction
        // côté règles — Firestore ne laisse pas une règle voir l'effet
        // d'une autre écriture de la même transaction, y compris
        // l'incrément du compteur fait dans le même lot applicatif). La
        // valeur sert de piste d'audit et rend une incohérence visible
        // a posteriori (deux dossiers au même numéro = quelque chose a
        // sauté l'incrément), pas un verrou d'unicité — Firestore
        // n'offre pas de contrainte d'unicité sur un CHAMP, seulement sur
        // l'identifiant du document, et lier les deux sans Cloud Function
        // se paie en fragilité plus grande que le gain (essayé, retiré).
        //
        // RISQUE RÉSIDUEL ASSUMÉ, SANS CLOUD FUNCTION : rien n'empêche un
        // client techniquement outillé de créer un dossier valide sans
        // jamais incrémenter le compteur dans le même lot — la règle ne
        // peut pas vérifier qu'une AUTRE écriture a eu lieu. C'est
        // exactement le même résidu que celui, déjà accepté, de
        // seven7_cabinets ci-dessus ; signalé en toutes lettres dans la
        // réponse à la section 9, jamais vendu comme une garantie absolue.
        allow create: if estAdmin(code)
          && cabinetActif(code)
          && quotaDisponible(code)
          && request.resource.data.creePar == request.auth.uid
          && request.resource.data.liasseVerrouillee == true
          && request.resource.data.numeroSequence == donneesCabinet(code).dossiersUtilises + 1;

        // E3 : la liasse (et le reste du dossier) n'est modifiable que
        // par l'ADMIN. liasseVerrouillee par dossier (phase 6) affinera
        // une ouverture ponctuelle à un collaborateur ; par défaut,
        // aucune règle ici ne permet à un COLLABORATEUR d'écrire quoi
        // que ce soit sur un dossier, lecture seule stricte. creePar et
        // numeroSequence, une fois posés à la création, ne sont plus
        // modifiables — ce sont des faits historiques, pas des champs
        // de travail.
        allow update: if estAdmin(code) && cabinetActif(code)
          && request.resource.data.creePar == resource.data.creePar
          && request.resource.data.numeroSequence == resource.data.numeroSequence;
        allow delete: if estAdmin(code);
      }
    }
  }
}
