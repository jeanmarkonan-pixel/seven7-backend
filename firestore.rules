// Règles déployées sur le projet seven7-audit, relevées dans la console
// Firebase le 03/08/2026. C'est désormais la référence : toute évolution
// se fait ici, puis `firebase deploy --only firestore:rules`.
//
// Couverture : tests/rules.test.js (émulateur Firestore, JDK requis).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /seven7_dossiers_public/{dossier} {
      allow get: if true;
      // Nouveau : lister TOUS les dossiers d'un cabinet (tableau de bord cabinet) n'est
      // autorisé qu'au compte Auth de CE cabinet précis (email fictif cabinet-{code}@...,
      // même mécanisme que les comptes Auth par dossier). La lecture d'un dossier UN PAR UN
      // (allow get, ci-dessus) reste publique et inchangée, pour ne rien casser côté écran
      // de connexion (affichage du nom de cabinet avant authentification).
      allow list: if request.auth != null
        && resource.data.cabinetId is string
        && request.auth.token.email == 'cabinet-' + resource.data.cabinetId.lower() + '@seven7-audit.local';
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
    }
    match /seven7_usage_stats/{jour} {
      allow read, write: if request.auth != null;
      match /cabinets/{cabinetId} {
        allow read, write: if request.auth != null;
      }
    }
    match /seven7_dossiers/{dossier} {
      allow read, update, delete: if request.auth != null
        && resource.data.authUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.authUid == request.auth.uid;
      allow update: if request.auth != null
        && !('authUid' in resource.data)
        && resource.data.password is string
        && request.resource.data.password == resource.data.password
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']);
      match /tabs/{tabId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
      }
      match /historique/{entryId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
      }
      match /presence/{sessionId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
      }
      match /archives/{archiveId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
        match /tabs/{tabId} {
          allow read, write: if request.auth != null
            && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
        }
      }
      match /conversations/{convId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
        match /messages/{msgId} {
          allow read, write: if request.auth != null
            && get(/databases/$(database)/documents/seven7_dossiers/$(dossier)).data.authUid == request.auth.uid;
        }
      }
    }
    match /seven7_cabinets/{cabinetId} {
      allow read: if true;
      // Seul le compteur "dossiersCreesAnnee" est modifiable depuis le client, par pas de
      // +1 exactement, et JAMAIS au-delà du plafond du cabinet. Le palier et le plafond
      // eux-mêmes ne se changent que depuis la console : aucune règle ne les autorise ici.
      //
      // La troisième condition avait disparu d'une version déployée. Son rétablissement
      // le 03/08/2026 est un CHOIX COMMERCIAL ASSUMÉ : le plafond bloque, un client qui
      // l'atteint doit changer de palier. La grille tarifaire annonçait jusqu'ici un
      // dépassement « facturé à l'unité » — cette possibilité n'existe plus côté serveur,
      // et la grille doit être mise à jour en conséquence.
      // Couverte par le test « CABINETS — le plafond d'abonnement est opposable ».
      //
      // DEUX CONDITIONS SUR LA DONNÉE, sous peine de bloquer des clients légitimes :
      //   · tout cabinet doit porter "plafondDossiers" — un document qui en est dépourvu
      //     fait échouer l'évaluation, donc refuse la création de dossier ;
      //   · le palier « Cabinet Plus » est illimité au tarif, mais pas dans le code : il
      //     se représente par un plafond très grand. Voir SEUIL_ILLIMITE = 9999 dans
      //     src/js/10-config-collaboration.js, au-delà duquel l'interface affiche
      //     « illimité » au lieu d'un chiffre.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dossiersCreesAnnee'])
        && request.resource.data.dossiersCreesAnnee == resource.data.dossiersCreesAnnee + 1
        && request.resource.data.dossiersCreesAnnee <= resource.data.plafondDossiers;
    }

    // ================================================================
    // NOUVEAU MODÈLE — phase 2 (schéma cabinets/rôles/paliers)
    //
    // Coexiste avec seven7_cabinets/seven7_dossiers ci-dessus, qu'il ne
    // modifie ni ne remplace : la période de transition (phase 3) exige
    // que l'ancien mécanisme de connexion reste fonctionnel. Un cabinet
    // migré porte migreDepuisAncienSchema: true (voir migration/) mais
    // son ancien document seven7_cabinets/{code} n'est jamais touché.
    //
    // Pas de Cloud Functions (plan Spark) : tout est porté par get() et
    // par la forme des écritures autorisées. Les limites précises de ce
    // choix sont documentées à l'endroit où elles s'appliquent, jamais
    // passées sous silence.
    // ================================================================

    function estMembre(code) {
      return request.auth != null
        && exists(/databases/$(database)/documents/cabinets/$(code)/membres/$(request.auth.uid));
    }
    function donneesMembre(code) {
      return get(/databases/$(database)/documents/cabinets/$(code)/membres/$(request.auth.uid)).data;
    }
    function estAdmin(code) {
      return estMembre(code) && donneesMembre(code).role == 'ADMIN' && donneesMembre(code).actif == true;
    }
    function donneesCabinet(code) {
      return get(/databases/$(database)/documents/cabinets/$(code)).data;
    }
    function cabinetActif(code) {
      return donneesCabinet(code).statut == 'ACTIF';
    }
    function quotaDisponible(code) {
      return donneesCabinet(code).dossiersUtilises < donneesCabinet(code).quotaDossiers;
    }

    match /cabinets/{code} {
      // Un membre lit son propre cabinet (nom, palier, quota affiché à
      // l'écran) ; la création/suppression d'un cabinet n'est jamais une
      // action client — c'est SEVEN7 qui l'exécute via le script de
      // migration ou l'onboarding, avec des identifiants de service.
      allow read: if estMembre(code);
      allow create, delete: if false;

      // Seul le compteur dossiersUtilises est modifiable depuis le
      // client, par pas de +1 exactement, jamais au-delà du quota — même
      // mécanisme, déjà éprouvé, que seven7_cabinets ci-dessus. plan,
      // quotaDossiers, statut, dateFin : AUCUNE règle ne les autorise ici,
      // ils sont donc en lecture seule côté client, sans exception.
      allow update: if estAdmin(code)
        && cabinetActif(code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dossiersUtilises'])
        && request.resource.data.dossiersUtilises == resource.data.dossiersUtilises + 1
        && request.resource.data.dossiersUtilises <= resource.data.quotaDossiers;

      match /membres/{uid} {
        // Un membre voit la liste de ses collègues (nom, rôle — pas de
        // secret ici) ; seul un ADMIN peut créer ou modifier un membre,
        // et jamais désactiver ou changer le rôle de SON PROPRE compte —
        // ce qui, combiné à l'interdiction de créer un second admin par
        // un non-admin, empêche un cabinet de se retrouver sans aucun
        // administrateur actif. Affiné en phase 4 (désactivation d'un
        // collègue, affectation de dossiers).
        allow read: if estMembre(code);
        allow create, update: if estAdmin(code) && uid != request.auth.uid;
        allow delete: if false;
      }

      match /dossiers/{dossierId} {
        // Un ADMIN lit tout ; un COLLABORATEUR ne lit que les dossiers
        // listés dans SON PROPRE document membre — jamais un tableau
        // fourni par le client, toujours relu en base.
        allow read: if estAdmin(code)
          || (estMembre(code) && dossierId in donneesMembre(code).dossiersAffectes);

        // E2 : seul l'ADMIN crée un dossier, jamais un collaborateur, ni
        // par l'interface ni par appel direct — c'est ici, pas dans
        // l'écran, que ça se joue réellement (§5 du cahier des charges).
        //
        // numeroSequence doit égaler dossiersUtilises + 1 du cabinet AU
        // MOMENT DE LA LECTURE (get(), donc l'état d'AVANT la transaction
        // côté règles — Firestore ne laisse pas une règle voir l'effet
        // d'une autre écriture de la même transaction, y compris
        // l'incrément du compteur fait dans le même lot applicatif). La
        // valeur sert de piste d'audit et rend une incohérence visible
        // a posteriori (deux dossiers au même numéro = quelque chose a
        // sauté l'incrément), pas un verrou d'unicité — Firestore
        // n'offre pas de contrainte d'unicité sur un CHAMP, seulement sur
        // l'identifiant du document, et lier les deux sans Cloud Function
        // se paie en fragilité plus grande que le gain (essayé, retiré).
        //
        // RISQUE RÉSIDUEL ASSUMÉ, SANS CLOUD FUNCTION : rien n'empêche un
        // client techniquement outillé de créer un dossier valide sans
        // jamais incrémenter le compteur dans le même lot — la règle ne
        // peut pas vérifier qu'une AUTRE écriture a eu lieu. C'est
        // exactement le même résidu que celui, déjà accepté, de
        // seven7_cabinets ci-dessus ; signalé en toutes lettres dans la
        // réponse à la section 9, jamais vendu comme une garantie absolue.
        allow create: if estAdmin(code)
          && cabinetActif(code)
          && quotaDisponible(code)
          && request.resource.data.creePar == request.auth.uid
          && request.resource.data.liasseVerrouillee == true
          && request.resource.data.numeroSequence == donneesCabinet(code).dossiersUtilises + 1;

        // E3 : la liasse (et le reste du dossier) n'est modifiable que
        // par l'ADMIN. liasseVerrouillee par dossier (phase 6) affinera
        // une ouverture ponctuelle à un collaborateur ; par défaut,
        // aucune règle ici ne permet à un COLLABORATEUR d'écrire quoi
        // que ce soit sur un dossier, lecture seule stricte. creePar et
        // numeroSequence, une fois posés à la création, ne sont plus
        // modifiables — ce sont des faits historiques, pas des champs
        // de travail.
        allow update: if estAdmin(code) && cabinetActif(code)
          && request.resource.data.creePar == resource.data.creePar
          && request.resource.data.numeroSequence == resource.data.numeroSequence;
        allow delete: if estAdmin(code);
      }
    }
  }
}
