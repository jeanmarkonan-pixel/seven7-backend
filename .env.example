# Copiez ce fichier en .env (jamais versionné) et renseignez les vraies valeurs.
# Console Firebase → Paramètres du projet → Vos applications → SDK Firebase.
# Requis avant tout `pnpm run build` / `pnpm run verifier` / `pnpm test`.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
